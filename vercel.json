{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/m/:token",
      "destination": "/api/mcp?token=:token"
    }
  ],
  "functions": {
    "api/mcp.js": {
      "maxDuration": 60,
      "memory": 1769,
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg"
    }
  }
}
